dialogue_lines = Array[String](["Finally! You are awake, Reader.", "Arjun: Wh-where am I? This isn't my room...", "You are in the Hollow. The saffron book summoned you because our realm is in peril.", "The Monster King watches from his floating fortress in the sky, sending beasts across our land.", "Take this blade! Press [Q] to swing your sword. Follow the road east through the training grounds to reach Mossveil Village!"])
