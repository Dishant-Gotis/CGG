[node name="NPC_Goblin_Grimm" type="StaticBody2D"]
collision_layer = 1
collision_mask = 0
script = ExtResource("1_npc")
npc_name = "Grimm the Torch Scout"
prompt_text = "E - Speak with Torch Scout"
dialogue_lines = [
"Wait! Hold your celestial blade, human traveler... I recognize that radiant silver aura!",
"Years ago, another human fell into our realm through the mysterious saffron book... He bore the same brave gaze as you.",
"He was your father! He ventured deep into these crystal depths searching for the sacred Elixir to heal our fractured worlds.",
"He carved his crest at the Crystal Sanctum further ahead across the glowing chasm. The Piece of Elixir rests upon the ancient altar!",
"Take the Elixir, traveler... fulfill your father's quest and reunite the fractured worlds!"
]
dialogue_lines_alt = [
"The Crystal Sanctum lies to the east across the bridge. Beware the rogue torch goblins who lost their minds to the darkness!",
"May your father's light guide your blade!"
]
required_flag = "talked_to_grimm"
grant_flag = "talked_to_grimm"

