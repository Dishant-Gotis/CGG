[node name="NPC_Elder" type="StaticBody2D"]
collision_layer = 1
collision_mask = 0
script = ExtResource("1_npc")
npc_name = "Elder Oakhaven"
prompt_text = "E - Speak with Elder"
dialogue_lines = [
"Welcome to Mossveil, Arjun. The stars whispered of your arrival from beyond the veil.",
"Look to the dark clouds above our valley — the floating castle of the Monster King casts its shadow upon our realm.",
"You proved your bravery by defeating the slimes along the high road. Our village honors your courage!",
"Take this sacred Cave Torch — it burns with an eternal amber flame.",
"South of the crossroads lies the pitch-black Mystic Cavern. Legends speak of a radiant Piece of Elixir sealed in its crystal depths.",
"Take the torch, delve into the cavern, and bring back the elixir piece!"
]
dialogue_lines_alt = [
"Peace be with you, Arjun.",
"The Cave Torch burns bright in your satchel [B]. Head south of the crossroads to explore the Mystic Cavern!",
"May the light protect you in the crystal depths."
]
required_flag = "elder_spoke"
grant_flag = "elder_spoke"
grant_item = "cave_torch"

