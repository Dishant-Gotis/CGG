[node name="NPC_Elder" type="StaticBody2D" parent="Objects" unique_id=1069854795 instance=ExtResource("34_dyafi")]
position = Vector2(3420, 580)
collision_mask = 0
script = ExtResource("9_18clu")
npc_name = "Elder Oakhaven"
prompt_text = "E - Speak with Elder"
dialogue_lines = Array[String](["Welcome to Mossveil, Snowy. The stars whispered of your arrival from beyond the veil.", "Look to the dark clouds above our valley — the floating castle of the Monster King casts its shadow upon our realm.", "You proved your bravery by defeating the slimes along the high road. Our village honors your courage!", "Take this sacred Cave Torch — it burns with an eternal amber flame.", "South of the crossroads lies the pitch-black Mystic Cavern. Legends speak of a radiant Piece of Elixir sealed in its crystal depths.", "Take the torch, delve into the cavern, and bring back the elixir piece!"])
dialogue_lines_alt = Array[String](["Peace be with you, Snowy.", "The Cave Torch burns bright in your satchel [B]. Head south of the crossroads to explore the Mystic Cavern!", "May the light protect you in the crystal depths."])
required_flag = "elder_spoke"
grant_flag = "elder_spoke"
grant_item = "cave_torch"

[node name="NPC_Guard" type="StaticBody2D" parent="Objects" unique_id=1356208306 instance=ExtResource("35_r5yoc")]
position = Vector2(3360, 420)
collision_mask = 0
script = ExtResource("9_18clu")
npc_name = "Mossveil Guard"
prompt_text = "E - Talk to Guard"
dialogue_lines = Array[String](["Halt! ...Wait. You carry the ancestral blade from the ancient lore.", "You fought your way through the slimes on the high road? Magnificent work, traveler!", "You are safe within the sturdy walls of Mossveil.", "The Elder is waiting for you at the Great Hall in the north of the village square."])
dialogue_lines_alt = Array[String](["Mossveil's gates are secure for now.", "Make sure you speak with Elder Oakhaven at the Great Hall."])
required_flag = "met_kitsu"

[node name="NPC_Lancer" type="StaticBody2D" parent="Objects" unique_id=555436765 instance=ExtResource("36_1m1ue")]
position = Vector2(3580, 380)
collision_mask = 0
script = ExtResource("9_18clu")
npc_name = "Sir Alden"
prompt_text = "E - Talk to Sir Alden"
dialogue_lines = Array[String](["Sir Alden: Stand firm, traveler! You stand before the royal citadel of Mossveil.", "Sir Alden: Our sentries watch over the eastern coast and the high battlements.", "Sir Alden: You carry the ancient sword... may its steel stay true in your journey."])
required_flag = "met_kitsu"

