npc_name = "Kitsu"
prompt_text = "E - Talk to Kitsu"
dialogue_lines = Array[String](["Finally! You are awake, Reader.", "Snowy: Wh-where am I? This isn't my room...", "You are in the Hollow. The saffron book summoned you because our realm is in peril.", "The Monster King watches from his floating fortress in the sky, sending beasts across our land.", "Take this blade! Press [Q] to swing your sword. Follow the road east through the training grounds to reach Mossveil Village!"])
dialogue_lines_alt = Array[String](["The path east leads past the training grounds straight into Mossveil Village.", "Be on your guard, Reader. The slimes on the road are quick, but your blade is swift!"])
