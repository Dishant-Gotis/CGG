[sub_resource type="GDScript" id="CrossroadsSignScript"]
script/source = "extends Area2D
var prompt_text: String = \"E - Read Sign\"

func interact(_player: Node) -> void:
	UI.start_dialogue([
		\"Crossroads Sign:\",
		\"⬆ North: High Pass & Mountains\",
		\"⬇ South: Whispering Pond & Mystic Caves\",
		\"➔ East: Training Grounds & Mossveil Village\"
	], \"Crossroads\")
"

[sub_resource type="RectangleShape2D" id="ShapeCave"]
size = Vector2(120, 50)

[sub_resource type="GDScript" id="CaveSignScript"]
script/source = "extends Area2D\nvar prompt_text: String = \"E - Read Sign\"\n\nfunc interact(_player: Node) -> void:\n\tif GameState.has_item(\"cave_torch\"):\n\t\tUI.start_dialogue([\n\t\t\t\"Mystic Cavern Signpost:\",\n\t\t\t\"Warning: Treacherous crystal precipices ahead.\",\n\t\t\t\"Your burning Cave Torch illuminates safe passage into the cavern.\",\n\t\t\t\"Step up to the cave opening to descend!\"\n\t\t], \"Cave Sign\")\n\telse:\n\t\tUI.start_dialogue([\n\t\t\t\"Mystic Cavern Signpost:\",\n\t\t\t\"Warning: Deep subterranean crystal chasms.\",\n\t\t\t\"The descent is pitch black and fatal without a continuous source of light.\",\n\t\t\t\"A Cave Torch is required to enter. Seek Elder Oakhaven in Mossveil Village!\"\n\t\t], \"Cave Sign\")\n"
[sub_resource type="GDScript" id="CombatSignScript"]
script/source = "extends Area2D
var prompt_text: String = \"E - Read Sign\"

func interact(_player: Node) -> void:
	UI.start_dialogue([
		\"Combat Training Ground: Prove your strength!\",
		\"Press Q to swing your sword at nearby enemies.\",
		\"Slimes will chase and damage you on contact.\",
		\"Defeat the slimes and proceed east to Mossveil Village!\"
	], \"Training Sign\")
"

[sub_resource type="GDScript" id="VillageSignScript"]
script/source = "extends Area2D
var prompt_text: String = \"E - Read Sign\"

func interact(_player: Node) -> void:
	UI.start_dialogue([
		\"Welcome to Mossveil Village!\",
		\"The great hall and town square lie ahead.\",
		\"You are safe within these walls, traveler.\"
	], \"Village Gate\")
"

[sub_resource type="GDScript" id="TownSquareSignScript"]
script/source = "extends Area2D
var prompt_text: String = \"E - Read Sign\"

func interact(_player: Node) -> void:
	UI.start_dialogue([
		\"Mossveil Town Square:\",
		\"North: Great Hall of the Elder\",
		\"East: Guard Watchtowers\",
		\"West: Return to High Road\"
	], \"Town Square\")
"

