npc_name = "Maya"
prompt_text = "E - Talk to Maya"
dialogue_lines = Array[String](["Hello there, traveler! Isn't Mossveil lovely this time of year?", "If you're feeling weary, rest by the fountain. The cool water does wonders for the spirit.", "Take care on your adventures, Snowy!"])
